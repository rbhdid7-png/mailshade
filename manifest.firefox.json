{
  "manifest_version": 3,
  "name": "Mailshade",
  "version": "1.1.0",
  "description": "Comfortable dark mode for Gmail and other webmail, without inverting the whole page.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Mailshade",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "scripts": ["shared.js", "background.js"]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "mailshade@local",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "permissions": ["storage", "activeTab"],
  "host_permissions": [
    "https://mail.google.com/*",
    "https://inbox.google.com/*",
    "https://outlook.live.com/*",
    "https://outlook.office.com/*",
    "https://outlook.office365.com/*",
    "https://mail.yahoo.com/*",
    "https://*.mail.yahoo.com/*",
    "https://mail.proton.me/*",
    "https://mail.protonmail.com/*",
    "https://www.icloud.com/*",
    "https://mail.aol.com/*",
    "https://mail.zoho.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*", "https://inbox.google.com/*"],
      "js": ["shared.js", "content.js"],
      "css": ["styles/base.css", "styles/gmail.css"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://outlook.live.com/*",
        "https://outlook.office.com/*",
        "https://outlook.office365.com/*"
      ],
      "js": ["shared.js", "content.js"],
      "css": ["styles/base.css", "styles/outlook.css"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://mail.yahoo.com/*",
        "https://*.mail.yahoo.com/*",
        "https://mail.aol.com/*"
      ],
      "js": ["shared.js", "content.js"],
      "css": ["styles/base.css", "styles/yahoo.css"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://mail.proton.me/*", "https://mail.protonmail.com/*"],
      "js": ["shared.js", "content.js"],
      "css": ["styles/base.css", "styles/proton.css"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.icloud.com/*", "https://mail.zoho.com/*"],
      "js": ["shared.js", "content.js"],
      "css": ["styles/base.css", "styles/generic.css"],
      "run_at": "document_start"
    }
  ]
}
